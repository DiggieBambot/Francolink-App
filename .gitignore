# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
src/app/api/seed/
src/lib/seed/

.claude/
*.bak
ssh-keygen*

# PM2 config — holds real secrets on the server. Copy the .example and fill it
# in there; never commit the filled-in version.
ecosystem.config.js

# Local scratch: throwaway probe/one-off scripts kept at the repo root.
_*.mts
_*.mjs

# Tool state, not project source.
.zcode/
supabase/.temp/

# Local dry-run output of scripts/generate-vocab-library.mjs — the library
# itself lives in Supabase Storage, these are just previews to eyeball.
/public/vocab-library/

# Generated book intermediates. book.html / the PDF are rebuilt by
# content/workbook/build/*.py; only the reader's copies are committed.
content/workbook/build/blocks.json
content/workbook/build/book.html
content/workbook/build/book-body.html
content/workbook/build/Le-Francais-Pas-a-Pas.pdf
